[Unit]
Description=rpi-monitor server (panel de bancas Raspberry Pi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rpi-monitor/server
ExecStart=/usr/bin/node src/index.js /opt/rpi-monitor/server/config.json
Restart=always
RestartSec=3
User=rpimon
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
